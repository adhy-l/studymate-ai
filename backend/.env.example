# StudyMate AI - Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development / production / test)
NODE_ENV=development

# Google Gemini API Key (leave empty to use local fallback responses)
GEMINI_API_KEY=

# Gemini Model Name (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum Upload File Size in Megabytes (default: 5MB)
MAX_FILE_SIZE_MB=5

# Session Expiry in Hours (in-memory)
SESSION_TTL_HOURS=2

# CORS Allowed Origin
CORS_ORIGIN=*
